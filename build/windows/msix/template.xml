<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="conch"
        Arguments=""
        InstallLocation="C:\Program Files\Conch\Conch">
    </Installer>
    <PackageInformation
        PackageName="Conch"
        PackageDisplayName="Conch"
        PublisherName="CN=Conch"
        PublisherDisplayName="Conch"
        Version="0.3.0.0"
        PackageDescription="Modern open-source SSH terminal">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.conch.app"
                Description="Modern open-source SSH terminal"
                DisplayName="Conch"
                ExecutableName="conch"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>Conch</DisplayName>
            <PublisherDisplayName>Conch</PublisherDisplayName>
            <Description>Modern open-source SSH terminal</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="conch.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
